datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator users {
  provider               = "prisma-client-js"
  output                 = "./generated/"
  binaryTargets          = ["native", "debian-openssl-3.0.x"]
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  firstName     String
  lastName      String
  phoneNumber   String?        @unique
  role          String         @default("GUEST")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  emailVerified Boolean        @default(false)
  careSeekers   CareSeeker[]   @relation("UserCareseeker")
  professionals Professional[] @relation("UserProfessional")
}

model CareSeeker {
  userId   String  @id
  user     User    @relation("UserCareseeker", fields: [userId], references: [id])
  isHelper Boolean @default(false)
}

model Professional {
  userId             String      @id
  user               User        @relation("UserProfessional", fields: [userId], references: [id])
  professionId       String?
  profession         Profession? @relation("ProfessionalProfession", fields: [professionId], references: [id])
  isMobile           Boolean     @default(false)
  interventionRadius Int         @default(0)
  siret              String?     @unique
  isSiretValid       Boolean     @default(false)
  //services                   ProfessionalService[]
}

model Profession {
  id                   String   @id @default(uuid())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  customProfession     String?
  isProfessionApproved Boolean  @default(false)
  professionName       String

  professionals Professional[] @relation("ProfessionalProfession")
}
