datasource db {
  provider = "postgresql"
  url = env("DB_URL")
}

generator users {
  provider = "prisma-client-js"
  output = "./generated/"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  generatedFileExtension = "ts"
  importFileExtension = "ts"
}

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  password          String
  firstName         String
  lastName          String
  phoneNumber       String?         @unique
  role              String          @default("GUEST")            
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  emailVerified     Boolean         @default(false)

  careSeekers       CareSeeker[]    @relation("UserCareseeker")
  professionals     Professional[]  @relation("UserProfessional")
  address           Address[]       @relation("UserAddress")
}

model CareSeeker {
  userId            String          @id
  isHelper          Boolean         @default(false)
  addressId         String?

  user              User            @relation("UserCareseeker", fields: [userId], references: [id], onDelete: Cascade)
  Appointments      Appointment[]   @relation("CareSeekerAppointments")
}

model Professional {
  userId                       String           @id
  professionId                 String?
  isMobile                     Boolean          @default(false)
  interventionRadius           Int              @default(0)
  siret                        String?          @unique
  isSiretValid                 Boolean          @default(false)

  user                         User             @relation("UserProfessional", fields: [userId], references: [id], onDelete: Cascade)
  profession                   Profession?      @relation("ProfessionalProfession", fields: [professionId], references: [id])

  Availabilities               Availability[]   @relation("ProfessionalAvailabilities")
  Appointments                 Appointment[]    @relation("ProfessionalAppointments")
}

model Profession {
  id                           String        @id @default(uuid())
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt
  customProfession             String?
  isProfessionApproved         Boolean       @default(false)
  professionName               String        

  professionals   Professional[]  @relation("ProfessionalProfession")
}

model Address {
  id                   String                @id @default(uuid())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  street               String?               
  postalCode           String?               
  city                 String
  latitude             Float?
  longitude            Float?
  label                String                @default("DOMICILE")
  userId               String
  
  user                 User                  @relation("UserAddress", fields: [userId], references: [id], onDelete: Cascade)

  careSeekerAppointments   Appointment[] @relation("CareSeekerAddress")
  professionalAppointments Appointment[] @relation("ProfessionalAddress")
}

model Availability {
  id                String         @id @default(uuid())
  start             DateTime
  end               DateTime
  title             String
  minimumDuration   Int           @default(60)
  maximumDuration   Int?
  professionalId    String

  professional      Professional  @relation("ProfessionalAvailabilities", fields: [professionalId], references: [userId], onDelete: Cascade)
}

model Appointment {
  id                        String           @id @default(uuid())
  start                     DateTime
  end                       DateTime
  title                     String
  description               String?
  status                    String          @default("PENDING")
  location                  String
  customLocation            String?
  careSeekerId              String
  professionalId            String
  careSeekerAddressId       String?
  professionalAddressId     String?

  careSeeker                CareSeeker      @relation("CareSeekerAppointments", fields: [careSeekerId], references: [userId], onDelete: Cascade)
  professional              Professional    @relation("ProfessionalAppointments", fields: [professionalId], references: [userId], onDelete: Cascade)
  careSeekerAddress         Address?        @relation("CareSeekerAddress", fields: [careSeekerAddressId], references: [id], onDelete: SetNull)
  professionalAddress       Address?        @relation("ProfessionalAddress", fields: [professionalAddressId], references: [id], onDelete: SetNull)
}